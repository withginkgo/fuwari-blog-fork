---
import VueCounter from "@components/demo/VueCounter.vue";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const integrationNotes = [
	"Installed `@astrojs/vue` and `vue`, then registered `vue()` in `astro.config.mjs`.",
	"Kept the existing Astro + Svelte structure intact and added Vue as another island option.",
	"Hydrated the demo component with `client:load` so the interaction starts immediately after page load.",
];
---

<MainGridLayout title="Vue Demo" description="A small Vue integration demo inside the Astro 6 blog project.">
	<div class="card-base px-8 py-8 md:px-10 md:py-10">
		<div class="vue-demo-eyebrow">Vue Integration</div>
		<h1 class="vue-demo-headline">Astro 6 now renders Vue islands in this project</h1>
		<p class="vue-demo-lead">
			This page keeps the existing blog structure unchanged and adds one Vue-powered
			island to confirm the integration works end to end.
		</p>

		<div class="vue-demo-grid">
			<section class="vue-demo-card">
				<h2>Interactive Vue component</h2>
				<p>
					The counter below is a <code>.vue</code> component rendered by Astro and hydrated
					on the client with <code>client:load</code>.
				</p>
				<div class="vue-demo-island">
					<VueCounter client:load headline="Vue works alongside Astro and Svelte" initialCount={6} />
				</div>
			</section>

			<section class="vue-demo-card">
				<h2>What changed</h2>
				<ul class="vue-demo-notes">
					{integrationNotes.map((note) => <li>{note}</li>)}
				</ul>
			</section>
		</div>
	</div>
</MainGridLayout>

<style>
	.vue-demo-eyebrow {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--primary);
		margin-bottom: 1rem;
	}

	.vue-demo-headline {
		font-size: clamp(2.1rem, 5vw, 4.2rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
		max-width: 11ch;
		margin: 0;
		color: rgb(15 23 42 / 0.92);
	}

	:global(.dark) .vue-demo-headline {
		color: rgb(248 250 252 / 0.92);
	}

	.vue-demo-lead {
		font-size: 1.02rem;
		line-height: 1.8;
		max-width: 56rem;
		margin: 1.35rem 0 0;
		color: rgb(15 23 42 / 0.68);
	}

	:global(.dark) .vue-demo-lead {
		color: rgb(226 232 240 / 0.7);
	}

	.vue-demo-grid {
		display: grid;
		gap: 1rem;
		margin-top: 2rem;
	}

	@media (min-width: 960px) {
		.vue-demo-grid {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
		}
	}

	.vue-demo-card {
		border: 1px solid rgb(15 23 42 / 0.08);
		border-radius: 1rem;
		padding: 1.25rem;
		background:
			linear-gradient(160deg, rgb(255 255 255 / 0.96), rgb(248 250 252 / 0.9));
	}

	:global(.dark) .vue-demo-card {
		border-color: rgb(255 255 255 / 0.08);
		background:
			linear-gradient(160deg, rgb(30 41 59 / 0.94), rgb(15 23 42 / 0.88));
	}

	.vue-demo-card h2 {
		margin: 0 0 0.75rem;
		color: rgb(15 23 42 / 0.86);
	}

	:global(.dark) .vue-demo-card h2 {
		color: rgb(248 250 252 / 0.9);
	}

	.vue-demo-card p {
		margin: 0;
		line-height: 1.75;
		color: rgb(15 23 42 / 0.66);
	}

	:global(.dark) .vue-demo-card p {
		color: rgb(226 232 240 / 0.68);
	}

	.vue-demo-island {
		margin-top: 1rem;
	}

	.vue-demo-notes {
		margin: 1rem 0 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.75rem;
		line-height: 1.7;
		color: rgb(15 23 42 / 0.66);
	}

	:global(.dark) .vue-demo-notes {
		color: rgb(226 232 240 / 0.68);
	}

	.vue-demo-notes code,
	.vue-demo-card code {
		font-size: 0.9em;
	}
</style>
